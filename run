#!/bin/bash

ROOT_DIR=$(pwd)

if [ $# -eq 0 ]; then
  echo "Usage: $0 [go|templ|gen|tag]"
  echo ""
  echo "Commands:"
  echo "  go      - Generate templ and run backend with go run"
  echo "  templ   - Generate templ files in templates and backend"
  echo "  gen     - Alias for templ"
  echo "  tag     - Create a version tag and push to git"
elif ([[ $1 = "go" ]]); then  
  echo "Run go command..." && \
  ./run templ && \
  cd $ROOT_DIR/backend && go run .
elif ([[ $1 = "templ" ]] || [[ $1 = "gen" ]]); then  
  echo "Run templ command..." && \
  cd $ROOT_DIR/templates && templ generate && \
  cd $ROOT_DIR/backend && templ generate && \
  cd $ROOT_DIR
elif [ "$1" = "tag" ]; then
  MESSAGE="${*:2}"
  VERSION=$(git tag --list 'templates/v0.0.*' | cut -d. -f3 | sort -n | tail -1)
  VERSION=${VERSION:-0}
  TAG="templates/v0.0.$((VERSION + 1))"

  git add -A && \
  git commit -m "$MESSAGE" && \
  git push && \
  git tag "$TAG" && \
  git push origin "$TAG"
else 
  echo "unknown command"
fi
